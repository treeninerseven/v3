// USB-C line terminal -> RF module UART. No automatic RF commands.
#include <Arduino.h>
#include <string.h>
#include <usbd_cdc_if.h>
#include "TerminalCore.h"

#if !defined(USBCON) || !defined(USBD_USE_CDC)
#error "Enable USB CDC support, or select build-flash menu 14."
#endif

Uart SerialMioty(PC_11, PC_10); // RX, TX
constexpr size_t LINE_SIZE = 1024, OUTPUT_SIZE = 2048;
char line[LINE_SIZE];
uint8_t tx[LINE_SIZE], output[OUTPUT_SIZE];
size_t lineSize = 0, txSize = 0, txOffset = 0;
size_t outputHead = 0, outputTail = 0;
uint32_t dropped = 0;
bool discardLine = false, previousCR = false, wasOpen = false;

void queueByte(uint8_t c) {
  const size_t next = (outputHead + 1) % OUTPUT_SIZE;
  if (next == outputTail) { ++dropped; return; }
  output[outputHead] = c; outputHead = next;
}

void message(const char *text) {
  while (*text) queueByte(static_cast<uint8_t>(*text++));
}

void help() {
  message("\r\n[M3B AT TERMINAL v2] USB CDC 115200, DTR optional; RF 9600 8N1.\r\n"
          "Enter AT commands, then CR / LF / CRLF. One CR is appended.\r\n"
          "Escapes: \\t TAB, \\x1A Ctrl-Z, \\r CR, \\n LF, \\\\ backslash.\r\n"
          "Examples: AT | ATI | AT-MEUI? | AT-TU=1\\t41\\x1A\r\n"
          "Max input: 1023 characters. :help shows this text; Ctrl-C clears input.\r\n"
          "RF replies are raw. Wait for the complete reply before next command.\r\n");
}

void serviceRf() {
  for (unsigned i = 0; i < 64 && SerialMioty.available(); ++i) {
    const int c = SerialMioty.read();
    if (c >= 0) queueByte(static_cast<uint8_t>(c));
  }
  // Incremental writes keep receiving RF replies even for long commands.
  int room = SerialMioty.availableForWrite();
  size_t n = txSize - txOffset;
  if (room <= 0 || !n) return;
  if (n > static_cast<size_t>(room)) n = room;
  if (n > 32) n = 32;
  txOffset += SerialMioty.write(tx + txOffset, n);
}

void serviceOutput() {
  if (!CDC_connected()) return;
  const int room = SerialUSB.availableForWrite();
  if (room <= 0) return;
  size_t n = outputHead >= outputTail ? outputHead - outputTail : OUTPUT_SIZE - outputTail;
  if (n > static_cast<size_t>(room)) n = room;
  if (n > 64) n = 64;
  if (n) outputTail = (outputTail + SerialUSB.write(output + outputTail, n)) % OUTPUT_SIZE;
  if (outputHead == outputTail && dropped) {
    char warning[100];
    snprintf(warning, sizeof(warning), "\r\n[TERMINAL] Output overflow: %lu bytes lost.\r\n",
             static_cast<unsigned long>(dropped));
    dropped = 0; message(warning);
  }
}

void finishLine() {
  if (discardLine) message("\r\n[TERMINAL] Line too long; nothing sent.\r\n");
  else if (lineSize) {
    line[lineSize] = '\0';
    if (strcmp(line, ":help") == 0) help();
    else {
      txSize = AtTerminal::decode(line, lineSize, tx, sizeof(tx));
      txOffset = 0;
      if (!txSize) message("\r\n[TERMINAL] Invalid escape; nothing sent. Use :help.\r\n");
    }
  }
  lineSize = 0; discardLine = false;
}

void serviceInput() {
  // Leave subsequent lines in USB RX until the current command is on the UART.
  for (unsigned i = 0; i < 32 && txOffset == txSize && SerialUSB.available(); ++i) {
    const int value = SerialUSB.read();
    if (value < 0) break;
    const char c = static_cast<char>(value);
    if (c == 3) {
      lineSize = 0; discardLine = previousCR = false;
      message("\r\n[TERMINAL] Input cleared; no RF command sent.\r\n");
      continue;
    }
    if (c == '\n' && previousCR) { previousCR = false; continue; }
    previousCR = c == '\r';
    if (c == '\r' || c == '\n') { finishLine(); continue; }
    if (discardLine) continue;
    if (c == '\b' || c == 127) { if (lineSize) --lineSize; continue; }
    if (lineSize < sizeof(line) - 1) line[lineSize++] = c;
    else discardLine = true; // Reject the whole line, never transmit a truncated command.
  }
}

void setup() {
  __HAL_RCC_CRS_CLK_ENABLE();
  RCC_CRSInitTypeDef crs = {};
  crs.Prescaler = RCC_CRS_SYNC_DIV1; crs.Source = RCC_CRS_SYNC_SOURCE_USB;
  crs.Polarity = RCC_CRS_SYNC_POLARITY_RISING;
  crs.ReloadValue = __HAL_RCC_CRS_RELOADVALUE_CALCULATE(48000000, 1000);
  crs.ErrorLimitValue = RCC_CRS_ERRORLIMIT_DEFAULT;
  crs.HSI48CalibrationValue = RCC_CRS_HSI48CALIBRATION_DEFAULT;
  HAL_RCCEx_CRSConfig(&crs);
  // STM32 CDC otherwise refuses USBSerial::write when the host leaves DTR low.
  // Disable that requirement before enumeration/control-line requests arrive.
  SerialUSB.dtr(false);
  SerialUSB.begin(115200); SerialMioty.begin(9600);
}

void loop() {
  serviceRf(); // Also drain RF while USB is disconnected.
  const bool open = CDC_connected();
  if (open != wasOpen) {
    lineSize = 0; discardLine = previousCR = false;
    if (open) help();
    wasOpen = open;
  }
  if (open) serviceInput();
  serviceOutput();
}
