// Draw to the framebuffer only; the caller controls clearing and transmission.
inline bool drawMiotyLogo(Adafruit_GFX &display, uint16_t color = 1) {
  if (display.width() < MIOTY_LOGO_WIDTH || display.height() < MIOTY_LOGO_HEIGHT)
    return false;
  const int16_t x = (display.width() - MIOTY_LOGO_WIDTH) / 2;
  const int16_t y = (display.height() - MIOTY_LOGO_HEIGHT) / 2;
  display.drawBitmap(x, y, MIOTY_LOGO_BITMAP, MIOTY_LOGO_WIDTH, MIOTY_LOGO_HEIGHT, color);
  return true;
}
